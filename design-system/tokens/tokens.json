{
  "$schema": "https://yourtube.example/design-system/tokens/schema/v1.json",
  "version": "1.0.0",
  "_note": "Single source of truth for all YourTube design tokens. Dark-first. Edit this file — tokens.md and tokens.css are derived mirrors. Light-theme color TBDs will be filled by YT-0172.",

  "color": {
    "brand": {
      "accent": {
        "dark": "#8B5CF6",
        "light": "#7C3AED",
        "usage": "Primary interactive — buttons, links, scrubber fill, accent tint"
      },
      "accent-dim": {
        "dark": "#7C3AED",
        "light": "#6D28D9",
        "usage": "Pressed / active state of accent"
      },
      "accent-subtle": {
        "dark": "#8B5CF620",
        "light": "#7C3AED20",
        "usage": "12 % opacity tinted backgrounds behind accent elements"
      },
      "accent-on": {
        "dark": "#FFFFFF",
        "light": "#FFFFFF",
        "usage": "Text or icon rendered on top of an accent-colored background"
      }
    },
    "background": {
      "base": {
        "dark": "#0F0F0F",
        "light": "#F2F2F7",
        "usage": "Base page / screen background"
      },
      "surface": {
        "dark": "#1C1C1E",
        "light": "#FFFFFF",
        "usage": "Cards, sheets, bottom sheets, MiniPlayer container"
      },
      "surface-variant": {
        "dark": "#2C2C2E",
        "light": "#F2F2F7",
        "usage": "List row hover/press, elevated surface, search bar fill"
      },
      "surface-high": {
        "dark": "#3A3A3C",
        "light": "#E5E5EA",
        "usage": "Highest-elevation surface — rarely used directly"
      }
    },
    "border": {
      "subtle": {
        "dark": "#3A3A3C",
        "light": "#D1D1D6",
        "usage": "Dividers, subtle outlines"
      },
      "strong": {
        "dark": "#636366",
        "light": "#8E8E93",
        "usage": "Active field borders, focused rings"
      }
    },
    "foreground": {
      "primary": {
        "dark": "#FFFFFF",
        "light": "#000000",
        "usage": "Primary text — titles, headlines"
      },
      "secondary": {
        "dark": "rgba(235,235,245,0.80)",
        "light": "rgba(60,60,67,0.60)",
        "usage": "Secondary text — channel names, metadata"
      },
      "tertiary": {
        "dark": "rgba(235,235,245,0.40)",
        "light": "rgba(60,60,67,0.30)",
        "usage": "Placeholders, disabled text, empty/error icon glyph"
      },
      "on-accent": {
        "dark": "#FFFFFF",
        "light": "#FFFFFF",
        "usage": "Alias for brand.accent-on — text on accent background"
      }
    },
    "semantic": {
      "error": {
        "dark": "#FF453A",
        "light": "#FF3B30",
        "usage": "Destructive actions, error icons, remove tint in edit mode"
      },
      "error-surface": {
        "dark": "rgba(255,69,58,0.12)",
        "light": "rgba(255,59,48,0.10)",
        "usage": "Tinted background behind error content"
      },
      "success": {
        "dark": "#30D158",
        "light": "#34C759",
        "usage": "Download complete, positive confirmation"
      },
      "success-surface": {
        "dark": "rgba(48,209,88,0.12)",
        "light": "rgba(52,199,89,0.10)",
        "usage": "Tinted background behind success content"
      },
      "warning": {
        "dark": "#FFD60A",
        "light": { "TBD": true },
        "usage": "Warning notices (light value pending YT-0172)"
      }
    },
    "overlay": {
      "artwork": {
        "dark": "rgba(0,0,0,0.60)",
        "light": "rgba(0,0,0,0.55)",
        "usage": "Scrim on full-bleed artwork backgrounds"
      },
      "sheet": {
        "dark": "rgba(0,0,0,0.45)",
        "light": "rgba(0,0,0,0.35)",
        "usage": "Modal backdrop"
      }
    },
    "scrubber": {
      "track": {
        "dark": "#3A3A3C",
        "light": "#D1D1D6",
        "usage": "Progress bar / scrubber unfilled track"
      },
      "fill": {
        "dark": "#8B5CF6",
        "light": "#7C3AED",
        "usage": "Scrubber filled portion — matches brand.accent"
      },
      "thumb": {
        "dark": "#FFFFFF",
        "light": { "TBD": true },
        "usage": "Draggable scrubber thumb (light value pending YT-0172)"
      }
    },
    "skeleton": {
      "bg": {
        "dark": "#2C2C2E",
        "light": "#E5E5EA",
        "usage": "Skeleton loading block fill"
      },
      "shimmer": {
        "dark": "rgba(255,255,255,0.06)",
        "light": "rgba(255,255,255,0.60)",
        "usage": "Shimmer overlay on skeleton blocks"
      }
    },
    "motion-scrim": {
      "miniplayer": {
        "dark": "#1C1C1E",
        "light": { "TBD": true },
        "usage": "MiniPlayer container fill at start of expand transition"
      },
      "nowplaying": {
        "dark": "#0F0F0F",
        "light": { "TBD": true },
        "usage": "NowPlaying base background at end of expand transition"
      }
    }
  },

  "spacing": {
    "xs":  { "value": "4dp",  "px": "4px",  "usage": "Micro gaps, icon padding" },
    "sm":  { "value": "8dp",  "px": "8px",  "usage": "Track row gap, inner padding" },
    "md":  { "value": "16dp", "px": "16px", "usage": "Standard content padding, button horizontal padding" },
    "lg":  { "value": "24dp", "px": "24px", "usage": "Screen gutters, NowPlaying horizontal padding" },
    "xl":  { "value": "32dp", "px": "32px", "usage": "Large section spacing" },
    "2xl": { "value": "48dp", "px": "48px", "usage": "Extra-large separation" },
    "3xl": { "value": "64dp", "px": "64px", "usage": "Hero spacing" }
  },

  "typography": {
    "display-large": {
      "size": "32px",
      "weight": 600,
      "line-height": 1.2,
      "letter-spacing": "-0.02em",
      "usage": "Now-playing track title (displayLarge)"
    },
    "title-large": {
      "size": "20px",
      "weight": 600,
      "line-height": 1.35,
      "letter-spacing": "-0.02em",
      "usage": "Section headers (titleLarge)"
    },
    "title-medium": {
      "size": "18px",
      "weight": 600,
      "line-height": 1.35,
      "letter-spacing": "-0.02em",
      "usage": "Screen titles, playlist names (titleMedium)"
    },
    "body-large": {
      "size": "16px",
      "weight": 400,
      "line-height": 1.5,
      "letter-spacing": "0em",
      "usage": "Track row title (bodyLarge)"
    },
    "body-medium": {
      "size": "14px",
      "weight": 400,
      "line-height": 1.5,
      "letter-spacing": "0em",
      "usage": "Channel name, secondary metadata (bodyMedium)"
    },
    "label-small": {
      "size": "12px",
      "weight": 500,
      "line-height": 1.2,
      "letter-spacing": "0.04em",
      "usage": "Duration, badges, captions (labelSmall)"
    },
    "caption": {
      "size": "11px",
      "weight": 400,
      "line-height": 1.2,
      "letter-spacing": "0em",
      "usage": "Micro labels, duration in tight spaces"
    }
  },

  "radius": {
    "xs":   { "value": "4dp",   "px": "4px",   "usage": "Badges, chips, MiniPlayer artwork thumbnail" },
    "sm":   { "value": "8dp",   "px": "8px",   "usage": "Thumbnails in track rows" },
    "md":   { "value": "12dp",  "px": "12px",  "usage": "Cards, sheets, NowPlaying artwork, playlist cover" },
    "lg":   { "value": "16dp",  "px": "16px",  "usage": "MiniPlayer container top corners, bottom sheets" },
    "xl":   { "value": "20dp",  "px": "20px",  "usage": "Large modals" },
    "pill": { "value": "999dp", "px": "999px", "usage": "Buttons, avatar, pill chips, search bar" }
  },

  "motion": {
    "duration": {
      "short":        { "value": "150ms", "usage": "Fast micro-interactions (CSS --transition-fast)" },
      "standard":     { "value": "200ms", "usage": "Standard transitions (CSS --transition-std)" },
      "medium":       { "value": "300ms", "usage": "Slow transitions (CSS --transition-slow)" },
      "expand":       { "value": "320ms", "usage": "MiniPlayer → NowPlaying expand" },
      "collapse":     { "value": "260ms", "usage": "NowPlaying → MiniPlayer collapse" },
      "reduce-motion":{ "value": "120ms", "usage": "Both directions under reduce-motion (opacity-only)" },
      "cross-fade":   { "value": "240ms", "usage": "Scrim / background cross-fade during expand" }
    },
    "easing": {
      "standard": {
        "value": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
        "usage": "Material emphasized-decelerate / iOS easeOut equivalent — most transitions"
      },
      "exit": {
        "value": "cubic-bezier(0.3, 0.0, 0.8, 0.15)",
        "usage": "Accelerate easing; used for artwork on collapse"
      }
    },
    "delay": {
      "controls-fade-in": { "value": "200ms", "usage": "Transport controls fade-in delay during NowPlaying expand" }
    },
    "artwork": {
      "start-radius": { "value": "4px",  "usage": "Artwork corner radius at MiniPlayer (matches radius.xs)" },
      "end-radius":   { "value": "12px", "usage": "Artwork corner radius at NowPlaying (matches radius.md)" },
      "start-size":   { "value": "48dp", "usage": "MiniPlayer thumbnail size" },
      "end-size":     { "value": "screenWidth − 2 × 24dp", "usage": "NowPlaying artwork: full-bleed minus lg gutters" }
    }
  },

  "component": {
    "track-row": {
      "height":       "72px",
      "thumb-size":   "56px",
      "thumb-radius": "8px",
      "gap":          "8px",
      "padding-h":    "16px",
      "padding-v":    "8px"
    },
    "miniplayer": {
      "height":       "64px",
      "radius":       "16px",
      "thumb-size":   "48px",
      "thumb-radius": "4px"
    },
    "nowplaying": {
      "artwork-radius": "12px"
    },
    "searchbar": {
      "height": "44px",
      "radius": "999px"
    },
    "tabbar": {
      "height":    "56px",
      "icon-size": "24px"
    },
    "button": {
      "height-sm": "32px",
      "height-md": "44px",
      "height-lg": "52px",
      "radius":    "999px",
      "padding-h": "16px"
    },
    "tap-target-min": "44px",
    "skeleton-shimmer-cycle": "1400ms linear infinite",
    "empty-error-icon-size": "56dp",
    "scrubber": {
      "track-height": "4px",
      "thumb-size":   "16px"
    }
  },

  "shadow": {
    "none": { "dark": "none",                            "light": "none" },
    "sm":   { "dark": "0 1px 4px rgba(0,0,0,0.20)",     "light": "0 1px 4px rgba(0,0,0,0.08)" },
    "md":   { "dark": "0 4px 16px rgba(0,0,0,0.40)",    "light": "0 4px 16px rgba(0,0,0,0.12)" },
    "lg":   { "dark": "0 8px 32px rgba(0,0,0,0.60)",    "light": "0 8px 32px rgba(0,0,0,0.20)" }
  }
}
