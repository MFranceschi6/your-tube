    "plan-feature": "off",
    "review-mobile-pr": "off",
    "fix-ci": "off",
    "caveman:caveman-help": "off",
    "caveman:caveman-review": "off",
    "caveman:compress": "off",
    "caveman:caveman-commit": "off",
    "caveman:caveman": "off",
    "init": "off",
    "review": "off",
    "security-review": "off"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "LS(*)",
      "Edit(android/**)",
      "Edit(ios/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(.agents/**)",
      "Edit(obsidian-vault/**)",
      "Bash(cd android && ./gradlew :app:assembleDebug)",
      "Bash(cd android && ./gradlew testDebugUnitTest)",
      "Bash(cd android && ./gradlew lintDebug)",
      "Bash(cd ios && xcodebuild -list)",
      "Bash(cd ios && swiftformat . --lint)",
      "Bash(cd ios && swiftlint)"
    ],
    "ask": [
      "Bash(cd android && ./gradlew connectedDebugAndroidTest)",
      "Bash(cd ios && xcodebuild*)",
      "Bash(obsidian *)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(security *)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/google-services.json)",
      "Read(**/.env*)"
    ]
  }
}
